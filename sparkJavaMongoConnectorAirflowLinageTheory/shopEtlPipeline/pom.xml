<?xml version="1.0" encoding="UTF-8"?>
<!--
  shop-etl-pipeline
  =================
  MongoDB (raw) → Spark → PostgreSQL / EPAS (silver = curated schema)
  Design: sparkJavaMongoConnectorAirflowLinageTheory/ETL_Jobs_Data_Design_Guide.md

  Versions sparkETLPipelineDemo project mathi lidha che (tamara machine par chale che e check thayelu che).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.shop</groupId>
    <artifactId>shop-etl-pipeline</artifactId>
    <version>1.0.0</version>
    <name>shop-etl-pipeline</name>
    <description>Shop ETL jobs: MongoDB raw → PostgreSQL silver (Job-2 J2_SALES)</description>

    <properties>
        <java.version>17</java.version>
        <scala.binary.version>2.12</scala.binary.version>
        <spark.version>3.5.9</spark.version>
        <mongo-spark-connector.version>10.7.0</mongo-spark-connector.version>

        <!--
            Spark 3.5 runtime par Janino 3.1.9 thi code generate kare che.
            Spring Boot navu Janino lave che je Spark code generation todi nakhe che, etle pin karyu.
        -->
        <janino.version>3.1.9</janino.version>

        <!-- Java 17 par Spark ne aa JVM flags joie (spark-submit script pan aa j umere che) -->
        <spark.jvm.add-opens>
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.net=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
            --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens=java.base/sun.nio.cs=ALL-UNNAMED
            --add-opens=java.base/sun.security.action=ALL-UNNAMED
            --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
        </spark.jvm.add-opens>
    </properties>

    <dependencies>
        <!-- ===================== Spring Boot ===================== -->
        <!-- REST API trigger (POST /api/jobs/{job}/runs) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- /actuator/health: Airflow / load balancer health check -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            JdbcTemplate + HikariCP: meta tables (audit, watermark, lock) mate.
            JPA/Hibernate JANIBUJHI ne nathi lidhu: Hibernate 6 ne ANTLR 4.13 joie, Spark 3.5 ne ANTLR 4.9.
            Banne ek classpath par sathe na chale.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ===================== Database driver ===================== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- ===================== Apache Spark ===================== -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <exclusions>
                <!-- Spring Boot Logback vapare che. Spark nu Log4j SLF4J binding kadhyu, nahi to 2 binding thay. -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mongodb.spark</groupId>
            <artifactId>mongo-spark-connector_${scala.binary.version}</artifactId>
            <version>${mongo-spark-connector.version}</version>
        </dependency>
        <!--
            Spark 3.5 andar haju juni javax.servlet API vapare che (metrics servlet).
            Spring Boot 3 jakarta.servlet vapare che, etle javax API alag thi umeryu.
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!-- ===================== Test ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- mvn spring-boot:run mate -->
                    <jvmArguments>${spark.jvm.add-opens}</jvmArguments>
                    <!--
                        Be jar banshe:
                          shop-etl-pipeline-1.0.0.jar       → plain jar (fakt aapna classes)
                                                              Spark CLUSTER par executors ne aa moklay (spark.jars)
                          shop-etl-pipeline-1.0.0-exec.jar  → Spring Boot fat jar: java -jar thi chalavo
                    -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- java -jar ...-exec.jar vakhte add-opens flags automatic (alag thi lakhva na pade) -->
                            <Add-Opens>java.base/java.lang java.base/java.lang.invoke java.base/java.lang.reflect java.base/java.io java.base/java.net java.base/java.nio java.base/java.util java.base/java.util.concurrent java.base/java.util.concurrent.atomic java.base/jdk.internal.ref java.base/sun.nio.ch java.base/sun.nio.cs java.base/sun.security.action java.base/sun.util.calendar</Add-Opens>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${spark.jvm.add-opens}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
